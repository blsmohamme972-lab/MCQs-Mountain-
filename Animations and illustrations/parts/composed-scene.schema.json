{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical Motion composed scene v2",
  "type": "object",
  "required": [
    "version",
    "title",
    "caption",
    "duration",
    "format",
    "theme",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "duration": {
      "type": "number",
      "minimum": 2,
      "maximum": 60
    },
    "format": {
      "enum": [
        "portrait",
        "square",
        "landscape"
      ]
    },
    "theme": {
      "enum": [
        "clinical",
        "night"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "options": {
            "type": "object"
          },
          "instanceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(#[1-9][0-9]*)?$"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/$defs/endpoint"
          },
          "to": {
            "$ref": "#/$defs/endpoint"
          },
          "label": {
            "type": "string",
            "maxLength": 48
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": [
        "instanceId",
        "attachment"
      ],
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "attachment": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]*$"
        }
      }
    }
  }
}
