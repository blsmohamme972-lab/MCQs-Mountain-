{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical Motion reusable parts catalog",
  "type": "object",
  "required": ["version", "libraryType", "engine", "contract", "parts"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "libraryType": {"const": "medical-illustration-parts"},
    "engine": {"const": "parts/medical-parts.js"},
    "schema": {"type": "string"},
    "searchFields": {"type": "array", "items": {"type": "string"}},
    "contract": {"type": "object", "required": ["contractVersion", "coordinateSystem", "runtimeDiscovery", "composition"]},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "version", "category", "anatomyLevel", "role", "title", "description", "keywords", "aliases", "source", "limitations", "composition", "attachments", "bounds", "dependencies", "parameterSchema", "stateSchema"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "file": {"const": "parts/medical-parts.js"},
          "version": {"type": "integer", "minimum": 1},
          "category": {"type": "string", "minLength": 1},
          "anatomyLevel": {"enum": ["molecular", "cellular", "tissue", "organ", "instrument"]},
          "role": {"enum": ["cell", "organelle", "organism", "boundary", "structure", "mechanism", "instrument"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 240},
          "keywords": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
          "limitations": {"type": "string", "minLength": 1},
          "composition": {"type": "object", "required": ["viewBox", "anchor", "options"], "additionalProperties": false, "properties": {"viewBox": {"const": "0 0 640 440"}, "anchor": {"const": "center"}, "options": {"type": "array", "items": {"enum": ["x", "y", "scale", "rotation", "opacity", "accent", "theme", "params", "state", "time", "progress"]}}}},
          "attachments": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}, "additionalProperties": false}},
          "bounds": {"type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false, "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}},
          "parameterSchema": {"type": "object"},
          "stateSchema": {"type": "object"}
        }
      }
    }
  }
}
