{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Kafu MotionCards declarative scene source",
  "type":"object",
  "required":["schema_version","qid","duration_ms","takeaway","layers"],
  "properties":{
    "schema_version":{"const":1},
    "qid":{"type":"string","pattern":"^Q[0-9]{9}$"},
    "duration_ms":{"type":"integer","minimum":2000,"maximum":30000},
    "takeaway":{"type":"string","minLength":1,"maxLength":240},
    "layers":{"type":"array","minItems":1,"maxItems":80}
  }
}
