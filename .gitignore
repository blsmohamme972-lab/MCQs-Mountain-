.env*
.dev.vars*
!.env.example
!.dev.vars.example
.wrangler/
node_modules/
__pycache__/
*.pyc
*.log
/tmp/
/local-backups/
/app/vendor/

# MotionCards review videos are sent to the owner in chat only, never committed.
*.mp4
# ...except the two gold-standard example videos (chapters 20–25), kept as the look to copy.
!motioncards/gold-standard-examples/*.mp4

# Voice engine test clips (`voiceover.py sample`) are sent to the owner in chat only.
/work/voice-sample/

# Lean storage: a lesson is kept as lessons/ (lesson.json + WebP image), scenes/ and selection.json. The voice is
# rebuilt from the text (cached on the machine) and the ZIP goes to the owner in chat and lives in the bot.
/work/*/voice/
/dist/MCARDS_*.zip
