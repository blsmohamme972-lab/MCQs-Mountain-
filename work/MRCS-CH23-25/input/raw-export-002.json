  "questions": [
    {
      "local_id": 169,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "001",
      "lead_in": "",
      "stem": "A 35-year-old woman presents with a lump in the region of her right femoral triangle. This has gradually been growing in size over 2 years. It is 8 cm in diameter, neither painful nor tender, easily mobile and slips under the finger. What is the most likely diagnosis?",
      "options": [
        "Aneurysm of femoral artery",
        "Secondary metastasis",
        "Lipoma",
        "Lymphoma",
        "Soft tissue sarcoma"
      ],
      "answer": "C",
      "answer_source": "book_key",
      "explanation": "This patient has a lipoma on the front of her thigh, a benign tumour arising from the subcutaneous fat. The classical clinical features of the condition are: a slow-growing painless lump, non-tender, mobile and easily slips under the finger; referred to as the 'slipping' sign.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 168,
      "source_pages": [
        168
      ],
      "flag": "",
      "source_label": "MRCS Part A: 550 SBAs and EMQs || 2nd Edition",
      "id": "Q000009477",
      "book_id": "MRCS-PARTA-550-2E",
      "status": "source_verified",
      "version": 1
    },
    {
      "local_id": 170,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "002",
      "lead_in": "",
      "stem": "A 70-year-old man undergoes an anterior resection for rectal cancer. The histology from the specimen is reported as Dukes' stage B cancer. Which statement describes this stage?",
      "options": [
        "Confined to the bowel wall",
        "Metastasised to liver",
        "Metastasised to regional lymph nodes",
        "Penetrating mucosa",
        "Spread to perirectal (extra-rectal) tissues"
      ],
      "answer": "E",
      "answer_source": "book_key",
      "explanation": "Dukes' stage B denotes the spread of cancer to perirectal tissues beyond the rectal wall. In 1932 Cuthbert Dukes described the post-operative staging of rectal carcinoma in three stages (A to C) according to the spread.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 168,
      "source_pages": [
        168
      ],
      "flag": "",
      "source_label": "MRCS Part A: 550 SBAs and EMQs || 2nd Edition",
      "id": "Q000009478",
      "book_id": "MRCS-PARTA-550-2E",
      "status": "source_verified",
      "version": 1
    },
    {
      "local_id": 171,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "003",
      "lead_in": "",
      "stem": "A 60-year-old man underwent a total gastrectomy for carcinoma of the stomach. The histology of the surgical specimen shows a well-differentiated adenocarcinoma. Which of the following does this pathological feature indicate?",
      "options": [
        "Anaplastic growth",
        "Fibrous infiltration",
        "Increased mitosis",
        "Marked nuclear pleomorphism",
        "Original intestinal type epithelium"
      ],
      "answer": "E",
      "answer_source": "book_key",
      "explanation": "When a carcinoma is reported as being well differentiated, it signifies that the cells have a strong resemblance to the parent structure. Differentiation is a term used to mean the degree to which the tumour histologically resembles its cell of origin.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 168,
      "source_pages": [
        168
      ],
      "flag": "",
      "source_label": "MRCS Part A: 550 SBAs and EMQs || 2nd Edition",
      "id": "Q000009479",
      "book_id": "MRCS-PARTA-550-2E",
      "status": "source_verified",
      "version": 1
    },
    {
      "local_id": 172,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "004",
      "lead_in": "",
      "stem": "A 16-year-old boy has recently arrived in the UK for treatment of a Burkitt's lymphoma which is affecting the jaws. Which of the following is most likely aetiology of this malignant neoplasm?",
      "options": [
        "Aromatic amines",
        "Bacteria",
        "Genetically inherited",
        "Ultraviolet radiation",
        "Virus"
      ],
      "answer": "E",
      "answer_source": "book_key",
      "explanation": "The carcinogen in Burkitt's lymphoma is a virus discovered in 1964 by Michael Epstein, a pathologist, and Yvonne Barr, a virologist, and hence called Epstein-Barr virus (EBV).",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 169,
      "source_pages": [
        169
      ],
      "flag": "",
      "source_label": "MRCS Part A: 550 SBAs and EMQs || 2nd Edition",
      "id": "Q000009480",
      "book_id": "MRCS-PARTA-550-2E",
      "status": "source_verified",
      "version": 1
    },
    {
      "local_id": 173,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "005",
      "lead_in": "",
      "stem": "A 60-year-old man, who had a malignant tumour excised 5 years ago, presents with a painful, warm, pulsatile lump in the middle of his upper thigh. An X-ray of his femur shows a solitary lytic lesion on the upper shaft of the femur. Which of the following is the most likely malignant tumour that was resected 5 years ago?",
      "options": [
        "Colorectal carcinoma",
        "Gastric carcinoma",
        "Prostatic carcinoma",
        "Renal cell carcinoma",
        "Testicular teratoma"
      ],
      "answer": "D",
      "answer_source": "book_key",
      "explanation": "The primary tumour would have been a renal cell carcinoma (adenocarcinoma of the kidney). It is also known as Grawitz's tumour, hypernephroma or clear cell carcinoma.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 169,
      "source_pages": [
        169
      ],
      "flag": "",
      "source_label": "MRCS Part A: 550 SBAs and EMQs || 2nd Edition",
      "id": "Q000009481",
      "book_id": "MRCS-PARTA-550-2E",
      "status": "source_verified",
      "version": 1
    },
    {
      "local_id": 174,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "006",
      "lead_in": "",
      "stem": "A 56-year-old man, who has tested positive for AIDS, presents with a slightly painful, non-itchy, reddish-brown ulcerative skin lesion, 4 cm in diameter, on the dorsum of his left foot. This has been gradually increasing in size over 6 months. There is marked swelling of the foot and distal leg. What is the most likely diagnosis?",
      "options": [
        "Angiosarcoma",
        "Kaposi's sarcoma",
        "Lymphangiosarcoma",
        "Secondary skin metastasis",
        "Soft tissue sarcoma"
      ],
      "answer": "B",
      "answer_source": "book_key",
      "explanation": "As this patient is known to have AIDS, a vascular, ulcerative skin lesion in a limb is likely to be Kaposi's sarcoma which occurs in immunocompromised patients.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 169,
      "source_pages": [
        169
      ],
      "flag": "",
      "source_label": "MRCS Part A: 550 SBAs and EMQs || 2nd Edition",
      "id": "Q000009482",
      "book_id": "MRCS-PARTA-550-2E",
      "status": "source_verified",
      "version": 1
    },
    {
      "local_id": 175,
      "chapter_id": 24,
      "topic": "",
      "type": "sba",
      "source_number": "007",
      "lead_in": "",
      "stem": "A 3-year-old boy is brought to the emergency department by his mother, who says that while bathing her son she noticed asymmetry of her child's abdomen, with the right side looking much larger. He also had three episodes of haematuria over the previous 4 months. On examination, there is a mass in the right side of the abdomen and loin. The right iris is absent. What is the most likely diagnosis?",
      "options": [
        "Ganglioneuroma",
        "Hepatoblastoma",
        "Neuroblastoma",
        "Rhabdomyosarcoma of the urinary bladder",
        "Wilms' tumour (nephroblastoma)"
      ],
      "answer": "E",
      "answer_source": "book_key",
      "explanation": "This child has a right Wilms' tumour, the most common abdominal solid tumour in children. Haematuria, a rare symptom, denotes that the growth has invaded the renal pelvis and is therefore at a locally advanced stage.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 169,
      "source_pages": [
        169
      ],
