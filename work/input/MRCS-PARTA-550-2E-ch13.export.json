      "type": "sba",
      "source_number": "001",
      "lead_in": "",
      "stem": "A 34-year-old man is admitted to the intensive care unit. He has been assaulted and sustained a significant head injury. He is normally fit and well. Which of the following parameters is most likely to increase cerebral blood flow?",
      "options": [
        "Central venous pressure 18 mmHg",
        "Core temperature 37.4°C",
        "Mean arterial pressure 90 mmHg",
        "PaCO₂ 4.0 kPa",
        "PaO₂ 6.7 kPa"
      ],
      "answer": "E",
      "answer_source": "book_key",
      "explanation": "PaCO₂, a reduction in CO₂, reduces cerebral blood flow. However, in head injury this may be disrupted. Temperature decrease causes a decrease in blood flow. Central venous pressure helps to determine cerebral perfusion pressure but this will not directly affect CBF. Hypoxia increases cerebral blood flow.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 98,
      "source_pages": [
        98
      ],
