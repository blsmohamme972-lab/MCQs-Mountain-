    {
      "local_id": 91,
      "chapter_id": 13,
      "topic": "",
      "type": "sba",
      "source_number": "002",
      "lead_in": "",
      "stem": "An 18-year-old woman with a ventriculoperitoneal shunt, which was inserted in childhood for hydrocephalus, presents with acute onset confusion. A sample of cerebrospinal fluid is taken from the device for sending to the laboratories for analysis. Which of the following results is abnormal?",
      "options": [
        "Glucose: 4.4 mmol/L",
        "Opening pressure: 22 mmHg",
        "Protein: 0.3 g/L",
        "Red blood cell count: 2 × 10⁶/L",
        "White cell count: 2 × 10⁶/L"
      ],
      "answer": "B",
      "answer_source": "book_key",
      "explanation": "The normal CSF opening pressure is between 7–18 cmH₂O.",
      "images": [],
      "explanation_images": [],
      "group_id": "",
      "no_shuffle": false,
      "source_page": 98,
